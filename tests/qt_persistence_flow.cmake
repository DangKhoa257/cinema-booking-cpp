# Bon lan chay la bon tien trinh GUI rieng.
string(RANDOM LENGTH 10 ALPHABET 0123456789abcdef runId)
set(root "${DATA_DIR}/${runId}")
set(good "${root}/good")
set(bad "${root}/bad")
set(partial "${root}/partial")
set(otherRoom "${root}/other_room")
foreach(mode write read verify)
    execute_process(COMMAND "${APP}" "${mode}" "${good}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${mode} failed: ${result}\n${output}\n${error}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${otherRoom}")
foreach(name movies rooms showtimes customers tickets)
    configure_file("${good}/${name}.txt" "${otherRoom}/${name}.txt" COPYONLY)
endforeach()
file(APPEND "${otherRoom}/rooms.txt" "2|Phòng Hai|C1,C2\n")
file(READ "${otherRoom}/showtimes.txt" showtimes)
string(REPLACE "2|2|1|" "2|2|2|" showtimes "${showtimes}")
file(WRITE "${otherRoom}/showtimes.txt" "${showtimes}")
execute_process(COMMAND "${APP}" room "${otherRoom}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "other room test failed: ${result}\n${output}\n${error}")
endif()
file(MAKE_DIRECTORY "${bad}")
foreach(name movies rooms showtimes customers tickets)
    configure_file("${good}/${name}.txt" "${bad}/${name}.txt" COPYONLY)
endforeach()
file(WRITE "${bad}/showtimes.txt"
    "1|999|1|2026-12-01 19:00|2026-12-01 20:30|50000\n")
file(SHA256 "${bad}/showtimes.txt" before)
execute_process(COMMAND "${APP}" bad "${bad}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "bad snapshot test failed: ${result}\n${output}\n${error}")
endif()
file(SHA256 "${bad}/showtimes.txt" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "GUI overwrote the corrupt snapshot")
endif()
file(MAKE_DIRECTORY "${partial}")
configure_file("${good}/movies.txt" "${partial}/movies.txt" COPYONLY)
file(SHA256 "${partial}/movies.txt" before)
execute_process(COMMAND "${APP}" bad "${partial}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "missing file test failed: ${result}\n${output}\n${error}")
endif()
file(SHA256 "${partial}/movies.txt" after)
if(NOT before STREQUAL after OR EXISTS "${partial}/tickets.txt")
    message(FATAL_ERROR "GUI overwrote or completed the partial snapshot")
endif()
message(STATUS "GUI restored across processes and preserved corrupt snapshot")
